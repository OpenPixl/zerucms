---
/**
 * Section « Grille de tarifs » (`tarifs`, catalogue `src/lib/home-modules.ts`) :
 * formules côte à côte (prix, période, détails en liste cochée, bouton),
 * une formule pouvant être mise en avant avec une pastille.
 */
import Button from '../ui/Button.astro';
import EnTeteSection from './EnTeteSection.astro';
import { renderMarkdownFragment, typographie } from '../../lib/markdown-fragment';
import type { ElementSection } from '../../lib/home-modules';
import { classeFond } from '../../lib/section-fonds';

interface Props {
	surtitre?: string;
	titre?: string;
	texte?: string;
	note?: string;
	/** Couleur du fond (teinte de la charte, `src/lib/section-fonds.ts`). */
	fond?: string;
	formules: ElementSection[];
	niveau?: 1 | 2;
	/** Lien vers une page du site désactivée : masqué (`''`). */
	lien?: (href: string) => string;
}

const { surtitre, titre, texte, note = '', fond = 'gris', formules, niveau, lien = (href: string) => href } = Astro.props;
// Toute la largeur du conteneur, quel que soit le nombre de formules.
const colonnes = { 1: '', 2: 'md:grid-cols-2', 3: 'md:grid-cols-3', 4: 'sm:grid-cols-2 lg:grid-cols-4' }[formules.length] ?? 'md:grid-cols-2 lg:grid-cols-3';
const enTete = Boolean(surtitre || titre || texte);
---

{formules.length > 0 && (
	<section class:list={[classeFond(fond), 'py-16']}>
		<div class="mx-auto max-w-6xl px-4 sm:px-6">
			<EnTeteSection surtitre={surtitre} titre={titre} texte={texte} niveau={niveau} />
			<div class:list={['grid items-stretch gap-6', colonnes, enTete && 'mt-10']}>
				{formules.map((f) => {
					const avant = f.avant === 'oui';
					const href = f.lien ? lien(f.lien) : '';
					return (
						<div
							class:list={[
								'relative flex flex-col rounded-2xl border bg-surface p-6 shadow-sm',
								avant ? 'border-primary ring-2 ring-primary' : 'border-gray-100',
							]}
						>
							{avant && f.mention && (
								<span class="absolute -top-3 left-1/2 -translate-x-1/2 whitespace-nowrap rounded-full bg-primary px-3 py-1 text-xs font-semibold text-white">
									{typographie(f.mention)}
								</span>
							)}
							<h3 class="font-heading text-lg font-semibold text-gray-900">{typographie(f.titre ?? '')}</h3>
							{f.description && <div class="mt-1 text-sm font-light text-gray-600">{typographie(f.description)}</div>}
							<div class="mt-4 flex items-baseline gap-1">
								<span class="font-heading text-3xl font-bold text-gray-900">{typographie(f.prix ?? '')}</span>
								{f.periode && <span class="text-sm font-light text-gray-500">{typographie(f.periode)}</span>}
							</div>
							{f.details && <div class="tarif-details mt-4 text-sm text-gray-700" set:html={renderMarkdownFragment(f.details)} />}
							{f.bouton && href && (
								<div class="mt-auto pt-6">
									<Button href={href} variant={avant ? 'primary' : 'outline'} class="w-full justify-center">
										{typographie(f.bouton)}
									</Button>
								</div>
							)}
						</div>
					);
				})}
			</div>
			{note && <div class="mt-6 text-sm font-light text-gray-500">{typographie(note)}</div>}
		</div>
	</section>
)}

<style>
	/* « Ce qui est compris » : liste cochée. */
	.tarif-details :global(p + p),
	.tarif-details :global(p + ul),
	.tarif-details :global(ul + p) {
		margin-top: 0.75rem;
	}
	.tarif-details :global(li) {
		position: relative;
		padding-left: 1.5rem;
	}
	.tarif-details :global(li + li) {
		margin-top: 0.375rem;
	}
	.tarif-details :global(li)::before {
		content: '✓';
		position: absolute;
		left: 0;
		font-weight: 700;
		color: var(--color-primary);
	}
	.tarif-details :global(a) {
		color: var(--color-primary);
		text-decoration: underline;
	}
</style>
