---
import { Image } from 'astro:assets';
import { logo, logoWidth } from '../../lib/site-images';
import { SOCIAL_NETWORKS, association, getAddressLines } from '../../lib/association';
import { getContentPages } from '../../lib/content-pages';
const year = new Date().getFullYear();

/** Liens du bas : pages à l'emplacement « Pied de page » du module Pages (`pied:`, `src/lib/pied-pages.ts`). */
const legalLinks = (await getContentPages())
	.filter((p) => !p.access && p.pied.show)
	.sort((a, b) => a.pied.order - b.pied.order || a.title.localeCompare(b.title, 'fr'))
	.map((p) => ({ href: p.url, label: p.menu?.label ?? p.title }));

const socialLinks = Object.entries(association.social)
	.filter(([, url]) => !!url)
	.map(([key, url]) => {
		const network = SOCIAL_NETWORKS.find((n) => n.key === key);
		return {
			url: url as string,
			icon: network?.icon ?? 'fa-solid fa-link',
			label: network?.label ?? key.charAt(0).toUpperCase() + key.slice(1),
		};
	});
---

<!-- Couleurs propres au pied de page (charte graphique, src/lib/pied.ts). -->
<footer class="bg-pied text-pied-texte">
	<div class="mx-auto grid max-w-6xl gap-8 px-4 py-12 sm:px-6 md:grid-cols-3">
		<div>
			<p class="font-heading text-lg">
				<Image src={logo} alt={association.name} width={logoWidth(192)} height={192} class="h-auto max-h-16 w-auto max-w-[min(100%,18rem)]" />
			</p>
			<p class="mt-2 text-sm text-pied-texte/80">
				{association.description}
			</p>
		</div>

		<div>
			<p class="font-heading text-sm uppercase tracking-wide text-pied-texte">Contact</p>
			<ul class="mt-2 space-y-2 text-sm text-pied-texte">
				<li class="flex items-center gap-2">
					<i class="fa-solid fa-envelope w-4 text-pied-texte" aria-hidden="true"></i>
					<a href={`mailto:${association.email}`} class="hover:text-pied-texte">{association.email}</a>
				</li>
				<li class="flex items-center gap-2">
					<i class="fa-solid fa-phone w-4 text-pied-texte" aria-hidden="true"></i>
					<a href={`tel:${association.phone.replace(/\s/g, '')}`} class="hover:text-pied-texte">{association.phone}</a>
				</li>
				<li class="flex items-start gap-2">
					<i class="fa-solid fa-location-dot mt-1 w-4 text-pied-texte" aria-hidden="true"></i>
					<span class="whitespace-pre-line">{getAddressLines().join('\n')}</span>
				</li>
			</ul>
		</div>

		{
			socialLinks.length > 0 && (
				<div>
					<p class="font-heading text-sm uppercase tracking-wide text-pied-texte">Suivez-nous</p>
					<div class="mt-2 flex gap-4">
						{socialLinks.map(({ url, icon, label }) => (
							<a href={url} aria-label={label} class="text-lg text-pied-texte hover:text-pied-texte">
								<i class={icon} aria-hidden="true" />
							</a>
						))}
					</div>
				</div>
			)
		}
	</div>

	<div class="border-t border-pied-texte/10 px-4 py-4 text-center text-xs text-pied-texte/70">
		<p>&copy; {year} {association.name}. Tous droits réservés. | Propulsé par Astro et développé par OpenPixl</p>
		<p class="mt-2 flex flex-wrap items-center justify-center gap-x-3 gap-y-1">
			{
				legalLinks.map((l) => (
					<>
						<a href={l.href} class="hover:text-pied-texte">
							{l.label}
						</a>
						<span aria-hidden="true">·</span>
					</>
				))
			}
			<!-- Ouvre la modale de connexion (src/components/admin/AdminLoader.astro). -->
			<a href="#connexion" data-auth-open class="hover:text-pied-texte">
				<i class="fa-solid fa-lock text-[10px]" aria-hidden="true"></i>
				Espace Admin
			</a>
		</p>
	</div>
</footer>
