---
import FigureImage from '../../components/article/FigureImage.astro';
import PrevNextNav from '../../components/article/PrevNextNav.astro';
import ArticleLayout from '../../layouts/ArticleLayout.astro';
import TableOfContents from '../../components/article/TableOfContents.astro';
import ReadingProgress from '../../components/article/ReadingProgress.astro';
import PageHeader from '../../components/sections/PageHeader.astro';
import ShareTools from '../../components/article/ShareTools.astro';
import { getAllNews, renderNews, type NewsArticle } from '../../lib/news';
import { getAllActivities } from '../../lib/activites';
import { lienInscription } from '../../plugins/activites';
import { association } from '../../lib/association';
import { newsArticleJsonLd } from '../../lib/seo';

export async function getStaticPaths() {
	function toNavItem(article?: NewsArticle) {
		if (!article) return null;

		return {
			href: article.href,
			title: article.title,
			meta: article.author ? `${article.date} | ${article.author}` : article.date,
		};
	}

	const allNews = await getAllNews();
	// Actualité dédiée à une activité (onglet « Partage ») : fiche publiée seulement.
	const activities = new Map((await getAllActivities()).map((a) => [a.slug, a]));

	return allNews.map((article, index) => ({
		params: { slug: article.slug },
		props: {
			article,
			activity: article.activite ? (activities.get(article.activite) ?? null) : null,
			prev: toNavItem(allNews[index - 1]),
			next: toNavItem(allNews[index + 1]),
		},
	}));
}

const { article, activity, prev, next } = Astro.props;
const { html, headings } = await renderNews(article);
const inscription = activity ? lienInscription(activity) : null;
---

<ArticleLayout
	title={`${article.title} · ${association.name}`}
	description={article.excerpt}
	image={article.image}
	ogType="article"
	jsonLd={[newsArticleJsonLd(article, Astro.site)]}
	breadcrumbs={[
		{ label: 'Accueil', href: '/' },
		{ label: 'Actualités', href: '/actualites' },
		{ label: article.title },
	]}
>
	<PageHeader
		slot="page-header"
		title={article.title}
		description={article.author ? `${article.date} · ${article.author}` : article.date}
	/>

	<Fragment slot="sidebar">
		{headings.length > 1 && <ReadingProgress minutes={article.readingTime} />}
		<ShareTools title={article.title} class="mb-6" />
		{headings.length > 1 && <TableOfContents headings={headings} />}
	</Fragment>

	{article.image && (
		<FigureImage
			image={article.image}
			alt={article.title}
			caption={article.imageCredit}
			loading="eager"
			class="mb-8"
		/>
	)}

	{article.tag && (
		<span class="inline-block rounded-full bg-primary/10 px-3 py-1 text-xs font-medium text-primary">
			{article.tag}
		</span>
	)}

	<div class="markdown-content mt-6 font-light text-gray-700">
		{/* HTML nettoyé : balisage de l'auteur·rice gardé, code exécutable retiré. */}
		<Fragment set:html={html} />
	</div>

	{activity && (
		<aside class="mt-10 flex flex-col items-center gap-4 rounded-2xl bg-primary/5 px-6 py-6 text-center sm:flex-row sm:text-left">
			<div class="flex-1">
				<p class="font-heading font-semibold text-gray-900">{inscription ? 'Envie de participer ?' : 'En savoir plus'}</p>
				<p class="mt-1 text-sm font-light text-gray-600">{activity.title}</p>
			</div>
			<div class="flex flex-wrap items-center justify-center gap-3">
				<a
					href={activity.href}
					class="bouton bouton-contour"
				>
					Voir l'activité
				</a>
				{inscription && (
					<a
						href={inscription}
						class="bouton bouton-primaire gap-2"
					>
						<svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
							<path stroke-linecap="round" stroke-linejoin="round" d="M19 7.5v6m3-3h-6m-2.25-3.375a3.375 3.375 0 1 1-6.75 0 3.375 3.375 0 0 1 6.75 0ZM4 19.235v-.11a6.375 6.375 0 0 1 12.75 0v.109A12.318 12.318 0 0 1 10.374 21c-2.331 0-4.512-.645-6.374-1.766Z" />
						</svg>
						S'inscrire
					</a>
				)}
			</div>
		</aside>
	)}

	{/* La colonne de droite est masquée sous `lg` : on y replace le partage. */}
	<ShareTools title={article.title} class="mt-12 lg:hidden" />

	<div class="mt-12 border-t border-gray-100 pt-8">
		<PrevNextNav prev={prev} next={next} />

		<div class="mt-8 text-center">
			<a
				href="/actualites"
				class="inline-flex items-center gap-2 font-heading text-sm font-semibold text-primary transition-colors hover:text-secondary"
			>
				<svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
					<path stroke-linecap="round" stroke-linejoin="round" d="M7 16l-4-4m0 0l4-4m-4 4h18" />
				</svg>
				Retour aux actualités
			</a>
		</div>
	</div>
</ArticleLayout>
