---
/**
 * Page d'accueil : suite de sections choisies, ordonnées et rédigées depuis le
 * module « Pages » (catalogue src/lib/home-modules.ts, réglages dans
 * src/content/pages/_pages-site.md ; sans réglage : DEFAULT_HOME). Rendu
 * commun aux pages enrichies : src/components/sections/Sections.astro ;
 * photos des sections : dossier src/content/pages/.
 */
import Layout from '../layouts/Layout.astro';
import Sections from '../components/sections/Sections.astro';
import { getSitePage } from '../lib/site-pages-content';

// Titre et description pour les moteurs de recherche : section « Référencement ».
const { modules = [], t } = await getSitePage('accueil');
---

<Layout title={t.titre} description={t.description}>
	<Sections modules={modules} dossier="pages" />
</Layout>
