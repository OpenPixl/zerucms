---
import Layout from '../layouts/Layout.astro';
import PageHeader from '../components/sections/PageHeader.astro';
import Button from '../components/ui/Button.astro';
import FormGate from '../components/forms/FormGate.astro';
import { association, getAddressLines } from '../lib/association';
import { getSitePage } from '../lib/site-pages-content';

// Page du site désactivable et textes réglés depuis le module « Pages ».
const page = await getSitePage('contact');
// Désactivée : la page 404 du site (le HTML prérendu est retiré par src/integrations/site-pages.ts).
if (!page.active) return new Response(null, { status: 404 });
const { t } = page;

---

<Layout
	title={`${page.label} · ${association.name}`}
	description={t.description}
	breadcrumbs={[{ label: 'Accueil', href: '/' }, { label: page.label }]}
>
	<PageHeader
		slot="page-header"
		title={t.titre}
		description={t.accroche}
		markdown
	/>

	<section class="mx-auto grid max-w-5xl gap-12 px-4 py-16 sm:px-6 md:grid-cols-2">
		<div>
			<h2 class="text-xl text-gray-900">{t['coordonnees-titre']}</h2>
			<ul class="mt-4 space-y-3 font-light text-gray-600">
				<li><a href={`mailto:${association.email}`} class="hover:text-primary">{association.email}</a></li>
				<li><a href={`tel:${association.phone.replace(/\s/g, '')}`} class="hover:text-primary">{association.phone}</a></li>
				<li class="whitespace-pre-line">{getAddressLines().join('\n')}</li>
			</ul>
			<p class="mt-6 font-light text-gray-600">{t['coordonnees-texte']}</p>
		</div>

		<FormGate form="contact">
			<form class="space-y-4" data-contact>
				<div>
					<label for="name" class="champ-libelle">Nom</label>
					<input type="text" id="name" name="nom" required class="mt-1 champ" />
				</div>
				<div>
					<label for="email" class="champ-libelle">Email</label>
					<input type="email" id="email" name="email" required class="mt-1 champ" />
				</div>
				<div>
					<label for="subject" class="champ-libelle">Sujet</label>
					<input type="text" id="subject" name="sujet" class="mt-1 champ" />
				</div>
				<div>
					<label for="message" class="champ-libelle">Message</label>
					<textarea id="message" name="message" rows="5" required class="mt-1 champ"></textarea>
				</div>
				{/* Piège à robots : invisible, laissé vide par les personnes. */}
				<div class="hidden" aria-hidden="true">
					<label for="site">Ne pas remplir</label>
					<input type="text" id="site" name="site" tabindex="-1" autocomplete="off" />
				</div>
				<p data-contact-message class="hidden" role="status"></p>
				<Button variant="primary" class="w-full sm:w-auto">Envoyer le message</Button>
			</form>
		</FormGate>
	</section>
</Layout>

<script>
	// Envoi par `/api/contact` (e-mail à l'adresse de la structure) sans quitter la page.
	const form = document.querySelector<HTMLFormElement>('form[data-contact]');
	const message = form?.querySelector<HTMLElement>('[data-contact-message]');
	const bouton = form?.querySelector<HTMLButtonElement>('button');
	const afficher = (texte: string, ok: boolean) => {
		if (!message) return;
		message.textContent = texte;
		message.className = ok ? 'alerte-succes' : 'alerte-erreur';
	};
	form?.addEventListener('submit', async (event) => {
		event.preventDefault();
		if (bouton) bouton.disabled = true;
		const donnees = Object.fromEntries(new FormData(form));
		try {
			const reponse = await fetch('/api/contact', {
				method: 'POST',
				headers: { 'Content-Type': 'application/json' },
				body: JSON.stringify(donnees),
			});
			const corps = await reponse.json().catch(() => ({}));
			if (!reponse.ok) throw new Error(corps.error || 'Envoi impossible, réessayez plus tard.');
			form.reset();
			afficher('Merci, votre message a bien été envoyé. Nous vous répondrons rapidement.', true);
		} catch (err) {
			afficher((err as Error).message || 'Envoi impossible, réessayez plus tard.', false);
		} finally {
			if (bouton) bouton.disabled = false;
		}
	});
</script>
