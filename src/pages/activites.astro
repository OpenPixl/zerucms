---
import Layout from '../layouts/Layout.astro';
import PageHeader from '../components/sections/PageHeader.astro';
import ActivitesSection from '../components/sections/ActivitesSection.astro';
import WeeklyAgenda from '../components/sections/WeeklyAgenda.astro';
import { association } from '../lib/association';
import { seancesExtensions } from '../lib/extensions-site';
import { planningActivites, planningAffiche } from '../plugins/activites';

import { getSitePage } from '../lib/site-pages-content';

export const prerender = false;

// Page du site désactivable et textes réglés depuis le module « Pages ».
const page = await getSitePage('activites');
// Désactivée : la page 404 du site (le HTML prérendu est retiré par src/integrations/site-pages.ts).
if (!page.active) return new Response(null, { status: 404 });
const { t } = page;

// Séances lues dans Grist (outil « Planning » du plugin activités, aucune s'il
// est éteint ou le plugin inactif) et
// celles des extensions (ex. permanences de prise de RDV). Grist injoignable :
// pas de planning figé (il deviendrait vite faux), celles des extensions
// seules et un avertissement.
const permanences = await seancesExtensions();
let sessions = permanences;
let notice: string | undefined;
try {
	sessions = [...permanences, ...(await planningActivites())];
} catch (err) {
	// Une ligne, sans pile : l'erreur se répète à chaque visite de la page.
	console.error(`[activites] Grist injoignable pour le planning : permanences seules (${(err as Error).message})`);
	notice =
		'Le planning des activités est momentanément indisponible. ' +
		'Contactez-nous pour connaître les horaires des séances.';
}
// Calendrier affiché si l'outil « Planning » est allumé, ou pour les séances
// des extensions (ex. permanences de prise de RDV) s'il y en a.
const agendaVisible = planningAffiche() || sessions.length > 0;
---

<Layout
	title={`${t.titre} · ${association.name}`}
	description={t.description}
	breadcrumbs={[{ label: 'Accueil', href: '/' }, { label: page.label }]}
>
	<PageHeader
		slot="page-header"
		title={t.titre}
		description={t.accroche}
		markdown
	/>
	<ActivitesSection showHeading={false} />

	{agendaVisible && <WeeklyAgenda sessions={sessions} notice={notice} class="border-t border-gray-100" />}

	<section class="mx-auto max-w-3xl px-4 py-16 text-center sm:px-6">
		<h2 class="text-2xl text-gray-900">{t['bas-titre']}</h2>
		<p class="mt-4 font-light text-gray-600">{t['bas-texte']}</p>
	</section>
</Layout>
