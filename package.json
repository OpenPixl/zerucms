{
  "name": "zerucms",
  "type": "module",
  "version": "0.5.15",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build && npm run build:cli",
    "preview": "astro preview",
    "start": "node --env-file-if-exists=.env scripts/start.mjs",
    "service": "node scripts/service.mjs",
    "astro": "astro",
    "auth:user": "npm run -s build:cli && node dist/cli/auth-user.mjs",
    "build:cli": "esbuild scripts/auth-user.ts --bundle --platform=node --format=esm --log-level=warning \"--banner:js=import { createRequire } from 'node:module'; const require = createRequire(import.meta.url);\" --outfile=${ASTRO_OUT_DIR:-dist}/cli/auth-user.mjs",
    "contenu:init": "node scripts/contenu-initial.mjs",
    "postinstall": "node -e \"const f='./scripts/contenu-initial.mjs';require('fs').existsSync(f)&&import(f).then(m=>m.installerContenuInitial(process.cwd()))\""
  },
  "dependencies": {
    "@astrojs/mdx": "^7.0.8",
    "@astrojs/node": "^11.1.4",
    "@astrojs/rss": "^4.0.19",
    "@astrojs/vue": "^7.0.2",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/lora": "^5.3.0",
    "@fontsource-variable/montserrat": "^5.3.0",
    "@fontsource-variable/nunito": "^5.3.0",
    "@fontsource-variable/open-sans": "^5.3.0",
    "@fontsource-variable/raleway": "^5.3.0",
    "@fontsource-variable/roboto": "^5.3.0",
    "@fontsource-variable/source-sans-3": "^5.3.1",
    "@fontsource-variable/work-sans": "^5.3.0",
    "@fortawesome/fontawesome-free": "^7.3.1",
    "@tailwindcss/vite": "^4.3.3",
    "@vuepic/vue-datepicker": "^14.0.0",
    "astro": "^7.3.8",
    "date-fns": "^4.4.0",
    "fflate": "^0.8.2",
    "hast-util-from-html": "^2.0.3",
    "hast-util-sanitize": "^5.0.2",
    "hast-util-to-html": "^9.0.5",
    "mdast-util-from-markdown": "^2.1.0",
    "mdast-util-to-hast": "^13.2.1",
    "qrcode": "^1.5.4",
    "tailwindcss": "^4.3.3",
    "vue": "^3.5.42",
    "vue-draggable-plus": "^0.6.1",
    "yaml": "^2.9.1"
  },
  "allowScripts": {
    "esbuild": true
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@types/node": "^22.20.1",
    "@types/qrcode": "^1.5.6",
    "esbuild": "^0.28.2",
    "typescript": "^6.0.3"
  }
}
